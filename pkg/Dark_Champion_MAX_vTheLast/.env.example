DARK_API_KEY=generated-by-bootstrap
SANDBOX_API_KEY=generated-by-bootstrap
COLAB_MODE=false
AUXILIARY_MODE=docker
# Standard Colab without Docker: set AUXILIARY_MODE=external and all six *_EXTERNAL_URLs.
# External auxiliaries must be provisioned on a private control host; sandbox stays isolated there.
# REDIS_EXTERNAL_URL=
# QDRANT_EXTERNAL_URL=
# SEARXNG_EXTERNAL_URL=
# CRAWL4AI_EXTERNAL_URL=
# SANDBOX_EXTERNAL_URL=
# OPEN_WEBUI_EXTERNAL_URL=
WEBUI_SECRET_KEY=generated-by-bootstrap
CRAWL4AI_API_TOKEN=generated-by-bootstrap
SEARXNG_SECRET=generated-by-bootstrap

VLLM_BASE_URL=http://host.docker.internal:8000/v1
VLLM_API_KEY=generated-by-bootstrap
VLLM_MODEL=Qwen/Qwen2.5-Coder-14B-Instruct
VLLM_MODEL_REVISION=aedcc2d42b622764e023cf882b6652e646b95671

GATEWAY_PORT=8088
OPEN_WEBUI_PORT=3000
SEARXNG_PORT=8080
QDRANT_PORT=6333
CRAWL4AI_PORT=11235
RESEARCH_PORT=8090
SANDBOX_PORT=8091
EMBEDDING_PORT=8092
RERANKER_PORT=8093

REDIS_URL=redis://redis:6379/0
QDRANT_COLLECTION=dark_research
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
RESEARCH_MAX_ROUNDS=10
RESEARCH_QUERIES_PER_ROUND=5
RESEARCH_RESULTS_PER_QUERY=5
RESEARCH_MAX_SOURCES=100
RESEARCH_MAX_CHARS_PER_SOURCE=50000
REQUEST_TIMEOUT_SECONDS=300

VLLM_TRUST_REMOTE_CODE=false
RESEARCH_CHUNK_CHARS=4000
RESEARCH_CHUNK_OVERLAP=400
RESEARCH_TOP_K=12
VLLM_HOST=127.0.0.1
VLLM_MAX_MODEL_LEN=16384
VLLM_VERIFIED_CONTEXT_LIMIT=32768
VLLM_GPU_MEMORY_UTILIZATION=0.92
VLLM_MAX_NUM_BATCHED_TOKENS=8192
VLLM_MAX_NUM_SEQS=2
VLLM_TOOL_CALL_PARSER=hermes
HF_HUB_ENABLE_HF_TRANSFER=0
TOKENIZERS_PARALLELISM=true

DARK_GPU_PROFILE=a100-40gb

# Optional: crawl operator-declared internal services (comma-separated CIDRs/hosts).
# Cloud metadata, loopback and unspecified addresses always stay blocked.
RESEARCH_ALLOWED_INTERNAL_CIDRS=
